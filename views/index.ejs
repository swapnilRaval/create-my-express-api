<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="shell">
    <header>
      <h1><%= title %></h1>
      <p class="sub">
        Express API running in <strong><%= environment %></strong> on Node <%= nodeVersion %>
        &middot; up <%= uptimeSeconds %>s
      </p>
    </header>

    <section>
      <h2>Endpoints</h2>
      <table>
        <thead>
          <tr><th>Method</th><th>Path</th><th>Description</th></tr>
        </thead>
        <tbody>
          <% endpoints.forEach(function (endpoint) { %>
            <tr>
              <td><span class="method method--<%= endpoint.method.toLowerCase() %>"><%= endpoint.method %></span></td>
              <td><code><%= endpoint.path %></code></td>
              <td><%= endpoint.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <footer>
      <p>This page is rendered by EJS from <code>views/index.ejs</code>.</p>
    </footer>
  </main>
</body>
</html>
