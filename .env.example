# ---------------------------------------------------------------------------
# smoke-test - environment template
#
# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Never put a real secret in this file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public base URL, used to build links inside emails.
APP_URL=http://localhost:3000

# Comma-separated origins, or * to allow any. Set real origins in production.
CORS_ORIGIN=*

# Max request body size accepted by express.json / urlencoded.
BODY_LIMIT=1mb

# error | warn | info | http | debug | silent
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Local mongod. For Atlas use: mongodb+srv://user:pass@cluster.mongodb.net/smoke-test
MONGO_URI=mongodb://127.0.0.1:27017/smoke-test

# --- Authentication ----------------------------------------------------------
# Must be at least 32 characters. The generator wrote a random one into .env;
# generate another with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- File uploads ------------------------------------------------------------
# Relative paths resolve against the process working directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Email (SMTP) ------------------------------------------------------------
# Leave MAIL_HOST empty to log emails instead of sending them (development).
# Mailtrap, Mailpit and Ethereal all work as local SMTP sinks.
MAIL_HOST=
MAIL_PORT=587
# true only for port 465 (implicit TLS)
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="smoke-test <no-reply@example.com>"
